# ============================================================================
# SOS Pickup — server-side configuration for the ntfy.sh integration
#
# These values are read at request time by src/app/api/sos/route.ts.
# They must never be exposed to the browser: no NEXT_PUBLIC_ prefix, and no
# real values committed anywhere (this template lives in Git; secrets do not).
#
# Not configured yet — the ntfy integration is still pending, so every value
# below stays empty for now. Copy this file to .env.local when it is time.
# ============================================================================

# Private notification topic the friend's ntfy Android app subscribes to.
# For ntfy.sh, topic knowledge IS the access control, so pick a long,
# hard-to-guess name. The Android app must subscribe to the exact same topic.
NTFY_TOPIC=

# Override only for a self-hosted ntfy server. Empty means: use https://ntfy.sh.
NTFY_SERVER_URL=

# Optional access token for access-restricted topics (ntfy.sh tokens look
# like tk_...). Leave empty while the topic is public.
NTFY_AUTH_TOKEN=

# Notification priority for the SOS push (ntfy: 1 min … 5 max/urgent).
# Suggested value once integrated: 5
NTFY_PRIORITY=
