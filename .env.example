# ============================================================================
# SOS Pickup — server-side configuration
#
# Copy this file to .env.local for local development, and add the same values
# in the Vercel project settings for production.
#
# Rules:
# - Everything below is read at request time by server-side code only
#   (src/lib/env.ts) and must NEVER be exposed to the browser.
# - Do not use a NEXT_PUBLIC_ prefix on any of these variables.
# - Never commit real values; .env.local is git-ignored.
# ============================================================================

# --- Access control ---------------------------------------------------------

# Plain-text PIN the friend must type to open the SOS panel.
# Pick something not guessable (at least 4 characters); compare happens on the
# server, and the PIN is never echoed, logged, or stored.
SOS_PIN=

# Long random string that forms the private SOS URL:
#   https://<deployment>/private/<SOS_LINK_SECRET>
# Generate one with:  openssl rand -hex 32
SOS_LINK_SECRET=

# Long random string used to sign the authentication session cookies.
# Rotate it to invalidate all existing sessions.
# Generate one with:  openssl rand -hex 32
SOS_SESSION_SECRET=

# --- ntfy -------------------------------------------------------------------

# Private notification topic the friend's ntfy Android app subscribes to.
# On ntfy.sh, topic knowledge IS the access control, so pick a long,
# hard-to-guess name. The Android app must subscribe to the exact same topic.
NTFY_TOPIC=

# Override only for a self-hosted or locally-mocked ntfy server. Empty means
# https://ntfy.sh. Must be an http(s) URL.
NTFY_SERVER_URL=https://ntfy.sh

# Optional access token for access-restricted topics (ntfy.sh tokens look
# like tk_...). Leave empty while the topic is public.
NTFY_AUTH_TOKEN=

# ntfy priority for the SOS push: min, low, default, high, max, urgent (or 1-5).
NTFY_PRIORITY=urgent
